# Copy to .env and change the values. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optional: applications per week you are aiming for (default 5)
WEEKLY_APPLICATION_GOAL=5

# --- Production server only (see docs/DEPLOY-AWS.md). Leave commented out on your laptop. ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# DOMAIN=jobs.example.com
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=jobs.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://jobs.example.com
# DJANGO_HTTPS=1
# Optional: copy each backup to this S3 bucket (needs the AWS CLI and an EC2 role that can write to it)
# BACKUP_S3_BUCKET=my-job-tracker-backups
